#!/bin/bash
# Resolve the hostname allowlist into nftables IPv4/IPv6 sets.
# Private, link-local, and metadata addresses are never added.
set -euo pipefail

HOSTS_FILE=/etc/codexgw/egress-hosts
if [[ ! -f "$HOSTS_FILE" ]]; then
  echo "missing $HOSTS_FILE" >&2
  exit 1
fi
if ! command -v nft >/dev/null 2>&1; then
  echo "nftables is required" >&2
  exit 1
fi

is_blocked_v4() {
  local ip="$1"
  case "$ip" in
    10.*|192.168.*|169.254.*) return 0 ;;
    172.1[6-9].*|172.2[0-9].*|172.3[0-1].*) return 0 ;;
    127.*) return 0 ;;
    0.*|255.*) return 0 ;;
  esac
  return 1
}

is_blocked_v6() {
  local ip="$1"
  local lowered
  lowered="$(printf '%s' "$ip" | tr 'A-F' 'a-f')"
  case "$lowered" in
    fe80:*|fc*|fd*|::1|::) return 0 ;;
  esac
  return 1
}

v4=()
v6=()
while IFS= read -r line || [[ -n "$line" ]]; do
  host="${line%%#*}"
  host="${host%"${host##*[![:space:]]}"}"
  host="${host#"${host%%[![:space:]]*}"}"
  [[ -z "$host" ]] && continue
  if [[ "$host" == *"*"* ]]; then
    echo "wildcard hostnames are not resolved: $host" >&2
    exit 1
  fi
  while IFS= read -r addr; do
    [[ -z "$addr" ]] && continue
    if [[ "$addr" == *:* ]]; then
      if is_blocked_v6 "$addr"; then
        echo "refusing private or link-local AAAA for $host: $addr" >&2
        continue
      fi
      v6+=("$addr")
    else
      if is_blocked_v4 "$addr"; then
        echo "refusing private or link-local A for $host: $addr" >&2
        continue
      fi
      v4+=("$addr")
    fi
  done < <(timeout 8 getent ahosts "$host" | awk '{ print $1 }' | sort -u || true)
  echo "resolved $host v4=${#v4[@]} v6=${#v6[@]}" >&2
done < "$HOSTS_FILE"

nft flush set inet filter codex4
nft flush set inet filter codex6
if [[ "${#v4[@]}" -gt 0 ]]; then
  nft add element inet filter codex4 "{ $(printf '%s, ' "${v4[@]}" | sed 's/, $//') }"
fi
if [[ "${#v6[@]}" -gt 0 ]]; then
  nft add element inet filter codex6 "{ $(printf '%s, ' "${v6[@]}" | sed 's/, $//') }"
fi
echo "nft allowlist v4=${#v4[@]} v6=${#v6[@]}"
